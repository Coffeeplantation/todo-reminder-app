{
  "name": "todo-reminder-serverless",
  "version": 2,
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_SERVICE_KEY": "@supabase_service_key",
    "SENDGRID_API_KEY": "@sendgrid_api_key",
    "ANTHROPIC_API_KEY": "@anthropic_api_key",
    "SENDGRID_FROM_EMAIL": {
      "default": "noreply@todoreminder.app"
    }
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "buildCommand": "npm install",
  "outputDirectory": "."
}
